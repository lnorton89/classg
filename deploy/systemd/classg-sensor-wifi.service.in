[Unit]
Description=ClassG primary passive Wi-Fi sensor (@IFACE@)
Documentation=file://@CLASSG_HOME@/docs/architecture/adr/0003-sensor-process-isolation.md
After=network-online.target
Wants=network-online.target

# ADR-0003 asks for bounded restarts. A sensor whose adapter has been physically
# unplugged fails instantly and for ever, and an unbounded Restart=always turns
# that into a loop that burns CPU while looking like activity. Five failures
# inside five minutes stops it and leaves the unit in `failed`, which shows up
# in `systemctl status` and in the dashboard's health pane.
#
# systemd 252 (Bookworm) has no RestartSteps/RestartMaxDelaySec, so escalating
# backoff is not available here; give up visibly instead of backing off blindly.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Not root. AF_PACKET needs CAP_NET_RAW and retuning needs CAP_NET_ADMIN --
# nothing in the capture path needs the rest of root, and this process parses
# hostile RF input all day. The ambient set is inherited by the `iw` child
# processes the hopper spawns, and capture.preflight accepts these capabilities
# in place of euid 0. ClassG is receive-only -- these buy packet capture,
# never transmission.
User=@RUNAS@
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes

# The sensor writes nothing but the journal and the bus: the filesystem is
# read-only to it, /home included (the venv and config only need reading), and
# its /tmp is private. A parser bug fed crafted frames should end at a restart,
# not at the deploy tree.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

# Backstop against memory growth thrashing the SD card into swap. Steady-state
# is tens of MB; hitting this limit means a leak, and an OOM-kill plus restart
# is the recovery ADR-0003 already prescribes.
MemoryMax=512M

WorkingDirectory=@CLASSG_HOME@/services/sensor-wifi
EnvironmentFile=@CLASSG_HOME@/.env

# Monitor mode survives neither a reboot nor a replug, and moving the adapter
# between USB ports silently drops the interface back to managed -- observed on
# this Pi. Re-established on every start rather than assumed.
#
# The "+" runs this one command with full privileges, outside the sandbox
# above: it loads the driver (modprobe) and negotiates with NetworkManager,
# which the capability-limited sensor user cannot and should not do.
ExecStartPre=+@CLASSG_HOME@/scripts/setup-monitor.sh @IFACE@

ExecStart=@CLASSG_HOME@/services/sensor-wifi/.venv/bin/python -m classg_wifi.cli --sensor-id wifi-0 run --iface @IFACE@ --channels config/channels-primary.yaml

Restart=always
RestartSec=5

# The capture loop's own watchdog exits the process when it stops publishing
# heartbeats. That is only a recovery mechanism if something restarts it --
# without this unit, the watchdog is just a quieter way to die.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
