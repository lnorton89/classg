[Unit]
Description=ClassG SDR sensor (ADS-B via dump1090)
Documentation=file://@CLASSG_HOME@/docs/architecture/adr/0008-adsb-via-dump1090.md
After=network-online.target dump1090-mutability.service
Wants=network-online.target

# Wants, not Requires. dump1090 being down is a state this sensor is built to
# report -- it reconnects with backoff and heartbeats unhealthy while it waits
# (ADR-0003). Requires= would instead stop this unit whenever dump1090 stopped,
# which replaces a visible degraded sensor with an absent one.
Wants=dump1090-mutability.service

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Not root, and not in plugdev either: dump1090 owns the radio (ADR-0008) and
# this process only reads a TCP socket. A sensor that never touches the device
# has no business holding permission to.
User=@RUNAS@
WorkingDirectory=@CLASSG_HOME@/services/sensor-sdr
EnvironmentFile=@CLASSG_HOME@/.env

# Everything this process legitimately does is: read a TCP stream from
# dump1090, publish on the bus, write the journal. So it keeps no
# capabilities, cannot gain privileges, sees a read-only filesystem with a
# private /tmp, and can only open network and local sockets (AF_NETLINK stays
# in the list because glibc's resolver uses it to enumerate interfaces).
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Backstop against memory growth thrashing the SD card into swap. The binary's
# steady state is a few MB; hitting this means a leak, and an OOM-kill plus
# restart is the recovery ADR-0003 already prescribes.
MemoryMax=256M

# The web tier publishes fusion's 5556 on the host and fusion listens there, so
# both sensors connect outward. Two publishers cannot bind the same endpoint,
# which is what makes connect the right default rather than a workaround.
Environment=CLASSG_SDR_SOCKET_MODE=connect

ExecStart=@CLASSG_HOME@/services/sensor-sdr/target/release/classg-sensor-sdr adsb

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
