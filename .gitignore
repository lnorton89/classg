# Captures contain everything in RF range, not just drones -- your neighbours'
# networks are in there. Treat as sensitive; never commit.
# See docs/research/06-legal-and-ethics.md#privacy-of-your-own-capture
captures/*
!captures/README.md
!captures/.gitkeep
*.pcap
*.pcapng
*.cfile
*.iq
*.fc32

# Real-capture test vectors are gitignored, not committed: decoded, they carry
# the aircraft's real serial and the operator's real GPS position (see
# docs/research/06-legal-and-ethics.md). Generate your own locally with
# `python -m tests.extract_vectors`; tests/test_vectors_real.py skips cleanly
# when none is present. sample.json is hand-built synthetic data with no real
# capture bytes in it, so it stays committed as the always-on regression net.
services/sensor-wifi/tests/vectors/*
!services/sensor-wifi/tests/vectors/sample.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# Go
/services/fusion/fusion
/services/api/api
*.test

# Rust
target/

# Node
node_modules/
dist/
.vite/

# Local config and data
*.local.yaml
*.db
*.db-wal
*.db-shm
.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# Third-party reference data, fetched by scripts/fetch-*.sh. All of it is
# somebody else's, all of it goes stale, and none of it is small. Committing a
# copy would redistribute it and pin it to whatever month it was downloaded.
# See docs/ops/07-external-data.md.
/data/aircraft-database.csv
/services/sensor-wifi/data/ieee-oui.csv
/services/ui/public/tiles/

# Temp Folder
tmp/
# air (hot reload) build output. tmp_dir in services/*/.air.toml -- these are
# compiled binaries, tens of MB each.
.air/
build-errors.log

# TypeScript incremental build info -- regenerated on every build.
*.tsbuildinfo

# Dev-stack runtime state: sensor pidfile and log.
.dev/

# Host-agent state: the deploy agent and watchdog write here and the API reads
# it through a bind mount. Runtime state, never committed.
.agent-state/

# Git worktrees created by coding agents (codex, etc). The work belongs on a
# branch, not inside the primary checkout.
.codex-worktrees/
