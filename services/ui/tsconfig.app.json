{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Setting "types" at all disables auto-inclusion of every other @types
    // package, so anything providing a *global* namespace has to be listed.
    // "geojson" is what defines the GeoJSON.* types used by the map feature;
    // without it src/features/map/{geo,style}.ts fail with TS2503.
    "types": ["vite/client", "geojson"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  // Worker scope, not window scope. It is checked by tsconfig.worker.json.
  "exclude": ["src/sw.ts"]
}
