# ClassG environment. Copy to .env  (make env)
#
# Configuration is tiered -- see docs/architecture/adr/0007-configuration-tiers.md
#
#   environment  >  database  >  config/defaults.yaml  >  built-in default
#
# THE API IS TIERED. Its runtime settings (retention, topics, capture defaults,
# sensor declarations, operator-location exposure) now live in the database,
# seeded from config/defaults.yaml. They are NOT listed here any more. Change
# them at runtime instead:
#
#   curl localhost:8081/api/v1/config/settings
#   curl -X PUT localhost:8081/api/v1/config/settings -d '{"retention.tracks":"720h"}'
#
# Setting one of those as an environment variable still works, but the API will
# log it at startup, report source:"env" from /config/settings, mark the field
# read-only in the UI, and refuse a PUT against it with 409. That visibility is
# the point: the bug this replaced was three files disagreeing about the default
# store with no way to tell which won.
#
# FUSION AND SENSOR-WIFI ARE NOT TIERED YET. They still read the environment
# directly, so their variables below are the real source of truth for them.


# =============================================================================
# API -- Tier 1: bootstrap and secrets only
# =============================================================================

CLASSG_LISTEN=:8081
CLASSG_LOG_LEVEL=info

# libsql (default, persistent) or memory (ephemeral; configured entirely from
# config/defaults.yaml, for CI and throwaway dev runs).
CLASSG_STORE=libsql
CLASSG_DB=classg.db

# Path to the Tier 3 seed. Relative to services/api, where the binary runs.
CLASSG_CONFIG_SEED=../../config/defaults.yaml

# --- Secrets. Leave empty for a purely local database with no network calls,
# --- which is the default and fully functional. Never commit real values.
CLASSG_TURSO_URL=
CLASSG_TURSO_AUTH_TOKEN=
CLASSG_TURSO_SYNC_INTERVAL=1m

# --- Sign-in. Tier 1 rather than Tier 2 deliberately: a unit whose auth mode is
# --- editable through its own web UI can be switched off by whoever already got
# --- in. Empty is the same as unset everywhere below.
#
# required (default) or off. `off` is for a bench with no network, not for a
# unit on a tailnet -- it makes every endpoint public to anything that can
# reach the port.
CLASSG_AUTH_MODE=
# Sliding session lifetime, default 12h.
CLASSG_SESSION_TTL=

# --- Single sign-on (OIDC). All four of issuer, client id, secret and redirect
# --- URL together, or none: three of four is a configuration error and the API
# --- refuses to start rather than serving a half-wired login button.
CLASSG_OIDC_ISSUER=
CLASSG_OIDC_CLIENT_ID=
CLASSG_OIDC_CLIENT_SECRET=
CLASSG_OIDC_REDIRECT_URL=
CLASSG_OIDC_LABEL=
# Create an account on first SSO login (default false), and the role it gets.
# Never admin: the first admin is made deliberately, on the box.
CLASSG_OIDC_AUTO_PROVISION=
CLASSG_OIDC_ROLE=

# --- Mail, for email hooks. CLASSG_SMTP_FROM is required once a host is set.
CLASSG_SMTP_HOST=
CLASSG_SMTP_PORT=
CLASSG_SMTP_USERNAME=
CLASSG_SMTP_PASSWORD=
CLASSG_SMTP_FROM=
CLASSG_SMTP_STARTTLS=
CLASSG_SMTP_TLS=

# --- Host-side agents. Empty means the feature is simply unavailable, and the
# --- UI says which variable is missing rather than failing.
# Deploy agent state, also used to hand spectrum sweep requests to the sweep
# agent -- see docs/ops/12-spectrum-sweeps.md.
CLASSG_DEPLOY_STATE_DIR=
# Path to classg-sensor-sdr, when the API runs on the host and can exec it
# directly. Empty on a containerised unit, which sweeps through the agent above.
CLASSG_SDR_BIN=


# =============================================================================
# Bus topology -- shared by api, fusion and sensor-wifi
# =============================================================================
# These describe both ends of the sensor bus, so they must agree across the
# three services. Native Linux/Pi: the sensor binds, fusion dials.

CLASSG_DETECTION_ENDPOINT=tcp://127.0.0.1:5556
CLASSG_TRACK_ENDPOINT=tcp://127.0.0.1:5557
CLASSG_DETECTION_TOPIC=detection.
CLASSG_TRACK_TOPIC=track.
CLASSG_HEARTBEAT_TOPIC=heartbeat.

# Windows/WSL + Docker Desktop reverses socket ownership: fusion listens on the
# port Compose publishes and the WSL sensor connects outward, because container
# loopback and WSL loopback are not the same network. For that layout use:
#
#   CLASSG_DETECTION_ENDPOINT=tcp://host.docker.internal:5556
#   CLASSG_WIFI_SOCKET_MODE=connect
#   CLASSG_FUSION_DETECTION_SOCKET_MODE=listen


# =============================================================================
# Fusion  (still environment-driven)
# =============================================================================

CLASSG_FUSION_DETECTION_SOCKET_MODE=dial
CLASSG_FUSION_SENSOR_STALE_AFTER=30s
CLASSG_FUSION_TRACK_TTL=5m
CLASSG_FUSION_REAP_INTERVAL=1s


# =============================================================================
# sensor-wifi  (still environment-driven)
# =============================================================================

CLASSG_WIFI_SENSOR_ID=wifi-0
CLASSG_WIFI_INTERFACE=wlan-alfa
CLASSG_WIFI_CHANNEL=6
CLASSG_WIFI_SOCKET_MODE=bind
CLASSG_WIFI_ZMQ_HWM=1000
CLASSG_WIFI_HEARTBEAT_S=10

# Measured on a DJI Mini 5 Pro: ~4.17 Hz beacons (240 ms median), not the 1 Hz
# the design originally assumed. A 400 ms dwell therefore catches a beacon ~81%
# of the time. See docs/ops/04-calibration.md.
CLASSG_WIFI_DWELL_MS=400

# Paths are relative to services/sensor-wifi.
CLASSG_WIFI_CHANNELS_FILE=config/channels.yaml
CLASSG_WIFI_FINGERPRINTS_FILE=data/oui_fingerprints.yaml
CLASSG_WIFI_CAPTURE_OUT=captures/capture.pcap


# =============================================================================
# Web UI (Vite)
# =============================================================================

# true  -> MSW mocks; the app runs with no backend at all
# false -> proxy /api to VITE_API_TARGET
VITE_USE_MSW=true
VITE_API_TARGET=http://localhost:8081
VITE_API_BASE=/api/v1


# =============================================================================
# Docker Compose only
# =============================================================================

CLASSG_API_PORT=8081
CLASSG_UI_PORT=8080
CLASSG_BUS_PORT=5556

# Satellite basemap pre-cache. Keep the box tight: tile count grows roughly
# fourfold per zoom level, and the build fails before downloading if the request
# exceeds MAX_TILES.
CLASSG_SATELLITE_TILE_URL=
CLASSG_TILE_PRELOAD_BBOX=
CLASSG_TILE_PRELOAD_MIN_ZOOM=12
CLASSG_TILE_PRELOAD_MAX_ZOOM=15
CLASSG_TILE_PRELOAD_MAX_TILES=600
CLASSG_TILE_PRELOAD_CONCURRENCY=8


# =============================================================================
# Moved to config/defaults.yaml -- do not re-add here
# =============================================================================
# CLASSG_VERSION                     -> api.version
# CLASSG_UI_DIR                      -> api.ui_dir
# CLASSG_EXPOSE_OPERATOR_LOCATION    -> api.expose_operator_location
# CLASSG_EXPECTED_SENSORS            -> sensors.expected
# CLASSG_SENSOR_STALE_AFTER          -> sensors.stale_after
# CLASSG_SENSOR_RESTART_COMMAND      -> sensors.restart_command
# CLASSG_MAX_HISTORY                 -> fusion.max_history
# CLASSG_RETENTION_DETECTIONS        -> retention.detections
# CLASSG_RETENTION_TRACKS            -> retention.tracks
# CLASSG_RETENTION_INTERVAL          -> retention.interval
# CLASSG_CAPTURE_DIR                 -> capture.dir
# CLASSG_CAPTURE_DURATION_S          -> capture.duration_s
# CLASSG_CAPTURE_LABEL               -> capture.label
# CLASSG_CAPTURE_ALLOW_UNPRIVILEGED  -> capture.allow_unprivileged
# CLASSG_SENSOR_WIFI_DIR             -> capture.sensor_wifi_dir
# CLASSG_PYTHON                      -> capture.python_bin
#
# CLASSG_WIFI_INTERFACE and CLASSG_WIFI_CHANNEL appear in both places on
# purpose: sensor-wifi reads them from the environment, while the API keeps its
# own capture.* copies for operator-initiated captures.
# =============================================================================
# Optional external data sources
# =============================================================================
# Five free integrations, all OFF by default, all inbound only, all degrading to
# exactly the behaviour without them: a missing file or a dropped uplink costs
# enrichment, never detection. Full reasoning, including the two rules that
# shaped them: docs/ops/07-external-data.md
#
# These are Tier 2 settings (ADR-0007), so they also live in
# config/defaults.yaml and are editable at runtime through /config/settings.
# They are listed here because fusion and the Wi-Fi sensor read the environment
# rather than the database -- setting one here is what actually reaches them.
#
# Left commented deliberately. An empty uncommented assignment would override a
# value set earlier in this file, and blanking a receiver position by way of
# documenting it is not a good trade.

# --- Where this unit is ------------------------------------------------------
# "lat,lon" in decimal degrees. Shared with the map (map.receiver_position):
# a detector has one position, and a map centred somewhere the ADS-B query is
# not would be worse than either alone. Required by CLASSG_FUSION_NET_ADSB;
# 0,0 is refused as unset rather than treated as the Gulf of Guinea.
#CLASSG_RECEIVER_POSITION=

# --- Network ADS-B (adsb.lol) ------------------------------------------------
# Manned traffic for Class D correlation on a unit with no SDR fitted. Class D
# never raises confidence -- it exists to explain detections away. This is the
# only integration here that needs a live uplink, and the only one that reveals
# roughly where the unit is. Heartbeats like a radio, so a dead uplink shows up
# on the sensors page rather than as a quiet sky.
#CLASSG_FUSION_NET_ADSB=false
#CLASSG_FUSION_NET_ADSB_URL=https://api.adsb.lol
#CLASSG_FUSION_NET_ADSB_RADIUS_NM=25
#CLASSG_FUSION_NET_ADSB_INTERVAL=10s
#CLASSG_FUSION_NET_ADSB_SENSOR_ID=net-adsb-0

# --- Terrain elevation (OpenTopoData) ----------------------------------------
# Fills height_agl_m, which is what turns a geodetic altitude into the number an
# operator can act on. Worth enabling even with no uplink: point the URL at a
# local instance with SRTM tiles and set the interval to 0.
#CLASSG_FUSION_TERRAIN=false
#CLASSG_FUSION_TERRAIN_URL=https://api.opentopodata.org
#CLASSG_FUSION_TERRAIN_DATASET=srtm30m
#CLASSG_FUSION_TERRAIN_MIN_INTERVAL=1s
#
# NOT optional in practice. Elevation datasets report orthometric height;
# Remote ID reports height above the WGS-84 ellipsoid. Leaving this at 0 does
# not skip a correction -- it applies a wrong one, by the local geoid
# undulation, in the direction that makes flights look LOWER than they are.
# About -22 m around Seattle; up to 100 m elsewhere. Look yours up once.
#CLASSG_FUSION_TERRAIN_GEOID_OFFSET_M=0

# --- Aircraft names (OpenSky, offline) ---------------------------------------
# Turns "contact A1B2C3" into "N512UP, a Cessna 208". Read once at startup, no
# API call ever. Fetch with: make data-aircraft
#CLASSG_FUSION_AIRCRAFT_DB=data/aircraft-database.csv

# --- Wi-Fi vendor OUIs (IEEE, offline) ---------------------------------------
# Expands oui_owner_patterns in data/oui_fingerprints.yaml to every block IEEE
# actually assigned a vendor, instead of the handful anyone transcribed. Absent
# file means the hand-listed OUIs stay the baseline. Fetch with: make data-oui
#CLASSG_WIFI_OUI_REGISTRY=data/ieee-oui.csv

# --- Vector basemap (Protomaps / OpenFreeMap) --------------------------------
# NOT a setting: Vite substitutes it at build time, so it cannot live in the
# database like the rest. Either a local .pmtiles archive -- the only fully
# offline basemap, cut with scripts/fetch-basemap.sh -- or any MapLibre style
# URL such as https://tiles.openfreemap.org/styles/liberty. Empty falls back to
# the satellite raster proxy, then to range rings.
#VITE_BASEMAP_VECTOR_URL=
