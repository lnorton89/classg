# ClassG centralized runtime configuration.
# Copy to .env for local development. Explicit process environment variables
# always override values loaded from this file.

# Shared ZeroMQ topology
CLASSG_DETECTION_ENDPOINT=tcp://127.0.0.1:5556
CLASSG_TRACK_ENDPOINT=tcp://127.0.0.1:5557
CLASSG_DETECTION_TOPIC=detection.
CLASSG_HEARTBEAT_TOPIC=heartbeat.
CLASSG_TRACK_TOPIC=track.

# API
CLASSG_VERSION=0.1.0
CLASSG_LISTEN=:8081
CLASSG_STORE=memory
CLASSG_DB=classg.db
CLASSG_TURSO_URL=
CLASSG_TURSO_AUTH_TOKEN=
CLASSG_TURSO_SYNC_INTERVAL=1m
CLASSG_EXPOSE_OPERATOR_LOCATION=false
CLASSG_UI_DIR=../ui/dist
CLASSG_CAPTURE_DIR=../../captures
CLASSG_SENSOR_WIFI_DIR=../sensor-wifi
CLASSG_PYTHON=../sensor-wifi/.venv/bin/python
CLASSG_CAPTURE_ALLOW_UNPRIVILEGED=false
CLASSG_CAPTURE_DURATION_S=120
CLASSG_CAPTURE_LABEL=sensor-capture
CLASSG_EXPECTED_SENSORS=wifi-0:wifi
CLASSG_SENSOR_STALE_AFTER=30s
CLASSG_SENSOR_RESTART_COMMAND=systemctl restart %s
CLASSG_RETENTION_DETECTIONS=168h
CLASSG_RETENTION_TRACKS=2160h
CLASSG_RETENTION_INTERVAL=1h
CLASSG_MAX_HISTORY=512
CLASSG_LOG_LEVEL=info

# Wi-Fi sensor
CLASSG_WIFI_SENSOR_ID=wifi-0
CLASSG_WIFI_INTERFACE=wlan0
CLASSG_WIFI_CHANNEL=6
CLASSG_WIFI_CHANNELS_FILE=config/channels.yaml
CLASSG_WIFI_FINGERPRINTS_FILE=data/oui_fingerprints.yaml
CLASSG_WIFI_DWELL_MS=400
CLASSG_WIFI_HEARTBEAT_S=10
CLASSG_WIFI_ZMQ_HWM=1000
CLASSG_WIFI_SOCKET_MODE=bind
CLASSG_WIFI_CAPTURE_OUT=../../captures/capture.pcap

# UI (only VITE_-prefixed values are exposed to browser code)
VITE_USE_MSW=false
VITE_API_BASE=/api/v1
VITE_API_TARGET=http://localhost:8081
CLASSG_UI_PORT=8080
CLASSG_API_PORT=8081
CLASSG_BUS_PORT=5556

# Optional build-time satellite seed area (west,south,east,north). Missing
# tiles are fetched from USGS and cached by the running UI when online.
CLASSG_TILE_PRELOAD_BBOX=
CLASSG_TILE_PRELOAD_MIN_ZOOM=12
CLASSG_TILE_PRELOAD_MAX_ZOOM=15
CLASSG_TILE_PRELOAD_MAX_TILES=600
CLASSG_TILE_PRELOAD_CONCURRENCY=8
CLASSG_SATELLITE_TILE_URL=

# Reserved for modules whose runtime loops have not landed yet
CLASSG_FUSION_SENSOR_STALE_AFTER=30s
CLASSG_FUSION_TRACK_TTL=5m
CLASSG_FUSION_REAP_INTERVAL=1s
CLASSG_FUSION_DETECTION_SOCKET_MODE=dial
CLASSG_SDR_SENSOR_ID=sdr-0
CLASSG_SDR_DWELL_MS=100
CLASSG_BLE_SENSOR_ID=ble-0
